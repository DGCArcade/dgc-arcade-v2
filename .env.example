# ─────────────────────────────────────────────────────────────────────────────
# DGC ARCADE — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:5432/DBNAME
# Get this from: Supabase, Neon, Railway, or your IONOS VPS PostgreSQL install
DATABASE_URL=postgresql://user:password@localhost:5432/dgcarcade

# ── SERVER ────────────────────────────────────────────────────────────────────
# Port the API server listens on (default 8080)
PORT=8080

# Your live domain (used for OxaPay callback URLs)
SITE_URL=https://differentgrindcrw.com

# Node environment
NODE_ENV=production

# ── AUTH / SESSIONS ───────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — make this long and random!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# ── OXAPAY PAYMENTS ───────────────────────────────────────────────────────────
# OxaPay Merchant Key — for accepting crypto deposits
# Get from: https://oxapay.com → Dashboard → Merchant API
OXAPAY_MERCHANT_KEY=your_oxapay_merchant_key_here

# OxaPay Payout Key — for sending crypto withdrawals
# Get from: https://oxapay.com → Dashboard → Payout API
OXAPAY_PAYOUT_KEY=your_oxapay_payout_key_here

# ── OPTIONAL / FUTURE ─────────────────────────────────────────────────────────
# If you add email notifications later:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_email_password
