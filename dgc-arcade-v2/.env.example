# ─────────────────────────────────────────────────────────────────────────────
# DGC ARCADE — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to GitHub. (.env is gitignored — this template is safe.)
#
# In production these are set in the Render dashboard (Environment tab),
# NOT in this file. This template documents what each service expects.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE (Neon PostgreSQL) ──────────────────────────────────────────────
# Your Neon connection string. Neon requires SSL.
# Get it from: https://console.neon.tech → your project → Connection Details
# Format: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@your-endpoint.neon.tech/dgcarcade?sslmode=require

# ── AUTH ────────────────────────────────────────────────────────────────────
# Secret used to sign JWT login tokens — make it long and random.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# ── PLISIO PAYMENTS (crypto deposits + withdrawals) ─────────────────────────
# Plisio Secret API Key — powers deposits, the IPN callback, withdrawals,
# and the owner balance/bank views in the admin panel.
# Get it from: https://plisio.net → Dashboard → API → Secret Key
PLISIO_SECRET_KEY=your_plisio_secret_key_here

# ── SERVER ──────────────────────────────────────────────────────────────────
# Your live frontend domain — used for Plisio success/fail redirects.
SITE_URL=https://differentgrindcrew.com
# The base URL of this API. Required for Plisio IPN callbacks to reach the server.
API_URL=https://dgc-arcade-api.onrender.com

# Node environment. Set to "production" on Render. Controls DB SSL + caching.
NODE_ENV=production

# Port the API listens on. Render provides this automatically in production.
# Locally/dev it defaults to 8080.
# PORT=8080
